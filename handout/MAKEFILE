CONTENT := $(wildcard content/*.tex)

PANDOC_FLAGS := --citeproc --lua-filter=filters/callout2latex.lua

.PHONY: all clean

all: handout.pdf

handout.pdf: out/handout.pdf
	cp $< $@

out/handout.pdf: handout.tex $(CONTENT) | out
	latexmk -pdf -output-directory=out handout.tex

out:
	mkdir -p out
	mkdir -p out/content
	mkdir -p out/pandoc

clean:
	rm -f handout.pdf
	rm -rf out


